{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{backend/tests/**,ml_pipeline/service/test_*.py,ml_pipeline/hardware/**,docs/**,**/*.test.py,**/__pycache__/**,backend/coldchain.db}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/telemetry", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
